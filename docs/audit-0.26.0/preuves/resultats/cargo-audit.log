ndex"},{"name":"syn","version":"1.0.109","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"version_check","version":"0.9.5","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2024-0370","package":"proc-macro-error","title":"proc-macro-error is unmaintained","description":"proc-macro-error's maintainer seems to be unreachable, with no commits for 2 years, no releases pushed for 4 years, and no activity on the GitLab repo or response to email.\n\nproc-macro-error also depends on `syn 1.x`, which may be bringing duplicate dependencies into dependant build trees.\n\n## Possible Alternative(s)\n\n- [manyhow](https://crates.io/crates/manyhow)\n- [proc-macro2-diagnostics](https://github.com/SergioBenitez/proc-macro2-diagnostics)","date":"2024-09-01","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://gitlab.com/CreepySkeleton/proc-macro-error/-/issues/20","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}},{"kind":"unmaintained","package":{"name":"zbus_names","version":"4.3.4","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"d8bf88b4a3ff53e883001e0e0115b297a9d53c31b9c1edd2bfdd853e3428624e","dependencies":[{"name":"serde","version":"1.0.229","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"winnow","version":"1.0.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zvariant","version":"5.15.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0371","package":"zbus_names","title":"`zbus_names` is unmaintained","description":"The `zbus_names` crate is no longer maintained as a standalone crate.\n\nIt has been merged into [`zbus`](https://crates.io/crates/zbus) starting with version `6.0.0`, as its `names` module.\n\nUsers should migrate to [`zbus`](https://crates.io/crates/zbus), with its default features disabled if they only need the D-Bus name types.","date":"2026-10-16","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://github.com/z-galaxy/zbus/issues/2043","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}},{"kind":"unmaintained","package":{"name":"zvariant","version":"5.15.0","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"c1d34c27cc6cdd1f458427519dd6b8612f7b7e3f7b9a0b2355d041dda9869147","dependencies":[{"name":"endi","version":"1.1.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"enumflags2","version":"0.7.12","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"serde","version":"1.0.229","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"winnow","version":"1.0.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zcheapstr","version":"1.1.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zvariant_derive","version":"5.15.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zvariant_utils","version":"4.2.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0370","package":"zvariant","title":"`zvariant` is unmaintained","description":"The `zvariant` crate is no longer maintained as a standalone crate.\n\nIt has been merged into [`zbus`](https://crates.io/crates/zbus) starting with version `6.0.0`, as its `wire` module.\n\nUsers should migrate to [`zbus`](https://crates.io/crates/zbus), with its default features disabled if they only need the D-Bus wire format. Users of the GVariant format should migrate to [`zgvariant`](https://crates.io/crates/zgvariant).","date":"2026-10-16","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://github.com/z-galaxy/zbus/issues/2043","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}},{"kind":"unmaintained","package":{"name":"zvariant_derive","version":"5.15.0","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"864155e69b4352db0c7f374917bf45d1e0c8d17659c8b3dbf9795f3673f8c497","dependencies":[{"name":"proc-macro-crate","version":"3.5.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"proc-macro2","version":"1.0.107","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"quote","version":"1.0.47","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"syn","version":"3.0.6","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zvariant_utils","version":"4.2.0","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0372","package":"zvariant_derive","title":"`zvariant_derive` is unmaintained","description":"The `zvariant_derive` crate is no longer maintained as a standalone crate.\n\nIts derive macros are provided by [`zbus`](https://crates.io/crates/zbus) starting with version `6.0.0`.\n\nUsers should migrate to [`zbus`](https://crates.io/crates/zbus), with its default features disabled if they only need the D-Bus wire format.","date":"2026-10-16","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://github.com/z-galaxy/zbus/issues/2043","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}}],"unsound":[{"kind":"unsound","package":{"name":"glib","version":"0.18.5","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"233daaf6e83ae6a12a52055f568f9d7cf4671dabb78ff9560ab6da230ce00ee5","dependencies":[{"name":"bitflags","version":"2.13.2","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-channel","version":"0.3.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-core","version":"0.3.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-executor","version":"0.3.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-task","version":"0.3.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-util","version":"0.3.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"gio-sys","version":"0.18.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"glib-macros","version":"0.18.5","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"glib-sys","version":"0.18.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"gobject-sys","version":"0.18.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libc","version":"0.2.189","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"memchr","version":"2.8.3","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"once_cell","version":"1.21.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"smallvec","version":"1.16.2","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"thiserror","version":"1.0.69","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2024-0429","package":"glib","title":"Unsoundness in `Iterator` and `DoubleEndedIterator` impls for `glib::VariantStrIter`","description":"The `VariantStrIter::impl_get` function (called internally by implementations of the `Iterator` and `DoubleEndedIterator` traits for this type) was unsound, resulting in undefined behaviour.\n\nAn immutable reference `&p` to a `*mut libc::c_char` pointer initialized to `NULL` was passed as an argument to a C function that that mutates the pointer behind `&p` in-place (i.e. as an out-argument), which was unsound. After changes in recent versions of the Rust compiler, these unsound writes through `&p` now seem to be completely disregarded when building the `glib` crate with optimizations.\n\nThis subsequently caused all calls of `VariantStrIter::impl_get` to violate the safety requirements of the `std::ffi::CStr::from_ptr` function - which requires its argument to be a valid pointer to a C-style string - resulting in crashes due to `NULL` pointer dereferences.\n\nThis was fixed by passing the out-argument pointer explitly as `&mut p` instead of `&p`.\n\nThis issue has been present since this code was initially added in `glib` v0.15.0. The mismatch in mutability was likely missed (and not raised as an error by the compiler) because the C function wrapped by `VariantStrIter::impl_get` is variadic (`glib_sys::g_variant_get_child`), and the pointer in question is one of the variadic arguments.","date":"2024-03-30","aliases":["GHSA-wrw7-89jp-8q8g"],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unsound","references":[],"source":null,"url":"https://github.com/gtk-rs/gtk-rs-core/pull/1343","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":{"arch":[],"os":[],"functions":{"glib::VariantStrIter::last":[">=0.15.0, <0.20.0"],"glib::VariantStrIter::next":[">=0.15.0, <0.20.0"],"glib::VariantStrIter::next_back":[">=0.15.0, <0.20.0"],"glib::VariantStrIter::nth":[">=0.15.0, <0.20.0"],"glib::VariantStrIter::nth_back":[">=0.15.0, <0.20.0"]}},"versions":{"patched":[">=0.20.0"],"unaffected":["<0.15.0"]}},{"kind":"unsound","package":{"name":"rustix","version":"1.1.5","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"891efababe418670775f199f0d233d84843c227a0949a883ce15b37c78d6629d","dependencies":[{"name":"bitflags","version":"2.13.2","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"errno","version":"0.3.14","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libc","version":"0.2.189","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"linux-raw-sys","version":"0.12.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"windows-sys","version":"0.61.2","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0486","package":"rustix","title":"xattr functions mark unwritten bytes as initialized when given a zero-length buffer","description":"The extended-attribute functions in `rustix::fs` (`getxattr`, `lgetxattr`, `fgetxattr`, `listxattr`, `llistxattr` and `flistxattr`) write into a `Buffer` and then mark as many bytes initialized as the system call reported. When the buffer has zero length, the operating system treats the call as a size query: it writes nothing and returns the size of the attribute value or of the name list. rustix still marked that many bytes as initialized.\n\nPassing a `Vec` whose length equals its capacity through `spare_capacity` gives such a zero-length buffer, and rustix then set the vector's length past its capacity over memory that was never written. This is undefined behavior reachable from safe code. With an empty `&mut [MaybeUninit<u8>]` the call panics instead.\n\nFrom 1.1.6 these functions return an empty result for a zero-length buffer, and new `getxattr_query`, `lgetxattr_query`, `fgetxattr_query`, `listxattr_query`, `llistxattr_query` and `flistxattr_query` functions return the size. The 0.38 series did not have the `Buffer` API and is not affected.","date":"2026-10-27","aliases":["GHSA-jh2m-fhpj-3vr7"],"related":[],"collection":"crates","categories":[],"keywords":["xattr","uninitialized-memory"],"cvss":null,"informational":"unsound","references":[],"source":null,"url":"https://github.com/bytecodealliance/rustix/commit/8e6aaa6713d2bb64b1fdd8c472e3a32a10a76d70","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":{"arch":[],"os":[],"functions":{"rustix::fs::fgetxattr":[">=1.0.0, <1.1.6"],"rustix::fs::flistxattr":[">=1.0.0, <1.1.6"],"rustix::fs::getxattr":[">=1.0.0, <1.1.6"],"rustix::fs::lgetxattr":[">=1.0.0, <1.1.6"],"rustix::fs::listxattr":[">=1.0.0, <1.1.6"],"rustix::fs::llistxattr":[">=1.0.0, <1.1.6"]}},"versions":{"patched":[">=1.1.6"],"unaffected":["<1.0.0"]}},{"kind":"unsound","package":{"name":"tokio","version":"1.53.1","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"202caea871b69668250d242070849eb495be178ed697a3e98aebce5bc81a0bed","dependencies":[{"name":"bytes","version":"1.12.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libc","version":"0.2.189","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"mio","version":"1.2.3","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"pin-project-lite","version":"0.2.17","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"socket2","version":"0.6.5","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"tokio-macros","version":"2.7.2","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"windows-sys","version":"0.61.2","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0386","package":"tokio","title":"`AsyncFd::new` and related constructors violate I/O safety","description":"`tokio::io::unix::AsyncFd` provides safe constructors (`new`, `with_interest`, `try_new`, and `try_with_interest`) that accept any `T: AsRawFd` rather than requiring proof of ownership or validity of the file descriptor. Because `RawFd` implements `AsRawFd`, safe code can construct an `AsyncFd` from an arbitrary or closed file descriptor, or close/replace the underlying file descriptor while the `AsyncFd` is still alive.\n\nThis violates I/O safety in two ways:\n\n1. `AsyncFd<T>` implements `AsFd` for all `T: AsRawFd` by calling `BorrowedFd::borrow_raw(self.as_raw_fd())`, allowing safe code to obtain an arbitrary `BorrowedFd<'_>` without owning the file descriptor.\n2. Tokio's I/O driver stores a pointer to an internal allocation in the `epoll`/`kqueue` user data for registered file descriptors. If the underlying file descriptor is duplicated and then closed while an `AsyncFd` is alive, and the OS reuses that file descriptor number for a another IO resource on the same runtime, dropping the first `AsyncFd` deregisters the reused file descriptor number and frees the first while the original file description remains registered in `epoll`, leading to a use-after-free when a readiness event fires.\n\nStarting in Tokio 1.51.6, 1.53.3, and 1.54.0, `AsyncFd::new`, `AsyncFd::with_interest`, `AsyncFd::try_new`, and `AsyncFd::try_with_interest` are deprecated in favor of the `unsafe` constructors `AsyncFd::register` and `AsyncFd::register_with_interest`. Callers must ensure that the file descriptor remains valid, open, and unchanged for the lifetime of the `AsyncFd`.","date":"2026-10-13","aliases":[],"related":[],"collection":"crates","categories":["memory-corruption"],"keywords":["io-safety","use-after-free"],"cvss":null,"informational":"unsound","references":["https://github.com/tokio-rs/tokio/issues/8538","https://github.com/tokio-rs/tokio/issues/8539"],"source":null,"url":"https://github.com/tokio-rs/tokio/pull/8587","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":{"arch":[],"os":[],"functions":{"tokio::io::unix::AsyncFd::new":[">=0.3.2"],"tokio::io::unix::AsyncFd::try_new":[">=1.37.0"],"tokio::io::unix::AsyncFd::try_with_interest":[">=1.37.0"],"tokio::io::unix::AsyncFd::with_interest":[">=0.3.2"]}},"versions":{"patched":[">=1.51.6, <1.52.0",">=1.53.3"],"unaffected":["<0.3.2"]}}],"yanked":[{"kind":"yanked","package":{"name":"async-executor","version":"1.14.0","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"c96bf972d85afc50bf5ab8fe2d54d1586b4e0b46c97c50a0c9e71e2f7bcd812a","dependencies":[{"name":"async-task","version":"4.7.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"concurrent-queue","version":"2.5.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"fastrand","version":"2.5.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"futures-lite","version":"2.6.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"pin-project-lite","version":"0.2.17","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"slab","version":"0.4.12","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":null,"affected":null,"versions":null}]}}
