<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fusionné par Tauri dans l'Info.plist généré (tauri ios init). Chaque clé de permission est déclarée dans
	     scripts/ios/plist-contract.json par le lot du plugin qui la demande (ADR 0007, avenant I-01). -->
	<!-- Y-IOS-02 (ADR 0011 §23 point 2) : scan du QR d'association par barcode-scanner. CAP-IOS-01 (ADR 0015 §4.2) : la même clé sert au choix
	     « Prendre une photo » du scan de tâches (sélecteur de WKWebView) ; Vision lui-même n'en demande aucune. -->
	<key>NSCameraUsageDescription</key>
	<string>Spartiate utilise la caméra pour scanner le code d'association affiché sur votre PC et pour photographier une liste de tâches à lire.</string>
	<!-- CAP-IOS-01 (ADR 0015 §4.2) : dictée de l'app (plugin speech). Sans ces deux clés, la demande d'autorisation termine l'app. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Spartiate utilise le micro seulement pendant que vous dictez une tâche. Rien n'est enregistré.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Spartiate transforme votre dictée en texte sur l'iPhone, sans rien envoyer.</string>
	<!-- I-03 (ADR 0013 §2.1) : verrouillage par Face ID (plugin biometric). Sans cette clé, Face ID est indisponible (constat 6). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Spartiate utilise Face ID pour garder vos tâches privées.</string>
	<!-- SPA-006 : lectures uniquement du poids et du nombre de pas ; aucune donnée Santé n'est écrite ni envoyée. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Spartiate lit ton poids et tes pas pour les afficher dans l’application. Aucune autre donnée de Santé n’est consultée.</string>
	<!-- SPA-007 : Live Activity du compteur (extension SpartiateLiveActivity). Aucun entitlement restreint, aucun App Group, aucun push. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- ios-demarrage : le journal technique (codes et durées, sans donnée personnelle) est écrit dans Documents/Journal, visible dans l'app
	     Fichiers (Sur mon iPhone > Spartiate) pour être partagé en cas de blocage. Aucune autre exposition de Documents. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
