{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "PC Windows uniquement : zone de notification, démarrage avec Windows (D-01 à D-04) ; mise à jour retirée jusqu'à SPA-002 (D-30).",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-set-tray-labels",
    "allow-confirm-quit",
    "allow-set-quick-capture-shortcut",
    "allow-clear-quick-capture-shortcut",
    "allow-get-quick-capture-shortcut",
    "allow-capture-setup-error",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/doncivo/spartiate-releases/releases/*" }]
    }
  ]
}
