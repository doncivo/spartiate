{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spartiate",
  "version": "0.1.0",
  "identifier": "fr.spartiate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Spartiate",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "publisher": "Ali Cherif",
    "copyright": "Ali Cherif",
    "shortDescription": "Planificateur personnel",
    "longDescription": "Spartiate : planificateur personnel (tâches, routines, événements, checklists).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    },
    "iOS": {
      "minimumSystemVersion": "18.0"
    }
  }
}
